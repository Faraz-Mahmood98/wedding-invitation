# --- Database (Supabase / Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth ---
# Random 32+ char secret used to sign the httpOnly admin cookie.
AUTH_SECRET="replace-with-a-long-random-secret-min-16-chars"

# --- Tenancy / routing ---
# Wildcard root domain without scheme. Local: localhost:3000, Prod: mydomain.com
APP_ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Serve bundled invitation fixtures without a database (local dev / demos).
# Leave unset (or "false") once DATABASE_URL points at a real database.
INVITATION_DEMO="false"

# --- Uploads ---
# Leave both unset to store uploads on the local filesystem under public/uploads.
# Set both to push uploads to Vercel Blob instead.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
# STORAGE_PUBLIC_BASE_URL="https://xxxx.public.blob.vercel-storage.com"

# --- Rate limiting ---
RSVP_RATE_LIMIT_PER_MINUTE="10"
